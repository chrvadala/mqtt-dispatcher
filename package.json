  "dependencies": {
    "qlobber": "^8.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "aedes": "^1.2.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "jsdoc-to-markdown": "^9.1.3",
    "mqtt": "^5.16.0",
    "neostandard": "0.14.0-next.1",
    "portfinder": "^1.0.38"
  }
}
